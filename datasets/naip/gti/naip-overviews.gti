<GDALTileIndexDataset>
  <!-- Overview files of the NAIP visualization COGs: the 9.6 m state files, or the national file.
       naip.gti opens this at several resolutions with a FILTER choosing which. Tile addresses are
       in the naip:gti_location column of naip-overviews.parquet, relative to this folder. -->
  <IndexDataset>naip-overviews.parquet</IndexDataset>
  <LocationField>naip:gti_location</LocationField>
  <SortField>datetime</SortField>
  <SortFieldAsc>true</SortFieldAsc>
  <SRS>EPSG:4269</SRS>
  <ResX>0.00008</ResX>
  <ResY>0.00008</ResY>
  <MinX>-125.2</MinX>
  <MinY>23.2</MinY>
  <MaxX>-66.0</MaxX>
  <MaxY>49.92</MaxY>
  <Band band="1" dataType="Byte"><ColorInterp>Red</ColorInterp></Band>
  <Band band="2" dataType="Byte"><ColorInterp>Green</ColorInterp></Band>
  <Band band="3" dataType="Byte"><ColorInterp>Blue</ColorInterp></Band>
  <Band band="4" dataType="Byte"><ColorInterp>Alpha</ColorInterp></Band>
</GDALTileIndexDataset>
