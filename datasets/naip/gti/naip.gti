<GDALTileIndexDataset>
  <!-- NAIP visualization COGs as one mosaic for GDAL and QGIS, newest flight of each place on top.
       Open it as /vsicurl?empty_dir=yes&amp;url=https://data.source.coop/nthh/naip/stac/naip.gti
       (empty_dir stops GDAL asking for side files of every quad, which QGIS does not stop on its own,
       a 404 round trip each: 176 of them for one view at Alta). The tile addresses are in
       the naip:gti_location column of naip.parquet, relative to this folder, so GDAL reads each file
       by range through /vsicurl/. The mosaic is in NAD83 longitude and latitude (the quads' datum) at
       0.000005 degrees, about 0.5 m; QGIS reprojects it to the project CRS. Band 4 is alpha, so the
       masked border of each quad stays transparent. Zoomed out it reads the 9.6 m state overview
       files and then the national file, through naip-overviews.gti. The coarsest levels (down to
       0.04096 degrees, 1,445 x 652 pixels) keep a whole-country read, such as the statistics QGIS
       takes when the layer is added, to a few hundred kilobytes of the national file's own overviews. Made by
       datasets/naip/gti/naip.gti in github.com/nthh/data-publications. -->
  <IndexDataset>naip.parquet</IndexDataset>
  <LocationField>naip:gti_location</LocationField>
  <SortField>datetime</SortField>
  <SortFieldAsc>true</SortFieldAsc>
  <SRS>EPSG:4269</SRS>
  <ResX>0.000005</ResX>
  <ResY>0.000005</ResY>
  <MinX>-125.2</MinX>
  <MinY>23.2</MinY>
  <MaxX>-66.0</MaxX>
  <MaxY>49.92</MaxY>
  <Band band="1" dataType="Byte"><ColorInterp>Red</ColorInterp></Band>
  <Band band="2" dataType="Byte"><ColorInterp>Green</ColorInterp></Band>
  <Band band="3" dataType="Byte"><ColorInterp>Blue</ColorInterp></Band>
  <Band band="4" dataType="Byte"><ColorInterp>Alpha</ColorInterp></Band>
  <Overview><Factor>2</Factor></Overview>
  <Overview><Factor>4</Factor></Overview>
  <Overview><Factor>8</Factor></Overview>
  <Overview>
    <Dataset>naip-overviews.gti</Dataset>
    <OpenOptions><OOI key="FILTER">id &lt;&gt; 'national-latest'</OOI><OOI key="RESX">0.00008</OOI><OOI key="RESY">0.00008</OOI></OpenOptions>
  </Overview>
  <Overview>
    <Dataset>naip-overviews.gti</Dataset>
    <OpenOptions><OOI key="FILTER">id &lt;&gt; 'national-latest'</OOI><OOI key="RESX">0.00016</OOI><OOI key="RESY">0.00016</OOI></OpenOptions>
  </Overview>
  <Overview>
    <Dataset>naip-overviews.gti</Dataset>
    <OpenOptions><OOI key="FILTER">id &lt;&gt; 'national-latest'</OOI><OOI key="RESX">0.00032</OOI><OOI key="RESY">0.00032</OOI></OpenOptions>
  </Overview>
  <Overview>
    <Dataset>naip-overviews.gti</Dataset>
    <OpenOptions><OOI key="FILTER">id &lt;&gt; 'national-latest'</OOI><OOI key="RESX">0.00064</OOI><OOI key="RESY">0.00064</OOI></OpenOptions>
  </Overview>
  <Overview>
    <Dataset>naip-overviews.gti</Dataset>
    <OpenOptions><OOI key="FILTER">id &lt;&gt; 'national-latest'</OOI><OOI key="RESX">0.00128</OOI><OOI key="RESY">0.00128</OOI></OpenOptions>
  </Overview>
  <Overview>
    <Dataset>naip-overviews.gti</Dataset>
    <OpenOptions><OOI key="FILTER">id = 'national-latest'</OOI><OOI key="RESX">0.00256</OOI><OOI key="RESY">0.00256</OOI></OpenOptions>
  </Overview>
  <Overview>
    <Dataset>naip-overviews.gti</Dataset>
    <OpenOptions><OOI key="FILTER">id = 'national-latest'</OOI><OOI key="RESX">0.00512</OOI><OOI key="RESY">0.00512</OOI></OpenOptions>
  </Overview>
  <Overview>
    <Dataset>naip-overviews.gti</Dataset>
    <OpenOptions><OOI key="FILTER">id = 'national-latest'</OOI><OOI key="RESX">0.01024</OOI><OOI key="RESY">0.01024</OOI></OpenOptions>
  </Overview>
  <Overview>
    <Dataset>naip-overviews.gti</Dataset>
    <OpenOptions><OOI key="FILTER">id = 'national-latest'</OOI><OOI key="RESX">0.02048</OOI><OOI key="RESY">0.02048</OOI></OpenOptions>
  </Overview>
  <Overview>
    <Dataset>naip-overviews.gti</Dataset>
    <OpenOptions><OOI key="FILTER">id = 'national-latest'</OOI><OOI key="RESX">0.04096</OOI><OOI key="RESY">0.04096</OOI></OpenOptions>
  </Overview>
</GDALTileIndexDataset>
